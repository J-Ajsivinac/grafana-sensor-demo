    {
      "id": 100,
      "type": "text",
      "title": "Arquitectura del Sistema",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "<div style='display: flex; justify-content: space-around; align-items: center; padding: 20px; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border-radius: 8px;'>\n  <div style='text-align: center;'>\n    <div style='font-size: 32px; margin-bottom: 8px;'>[W]</div>\n    <div style='font-size: 14px; font-weight: bold; color: #00d8ff;'>Wokwi Simulator</div>\n    <div style='font-size: 11px; color: #8892b0; margin-top: 4px;'>Arduino UNO + Sensores</div>\n  </div>\n  <div style='font-size: 24px; color: #00d8ff;'>-></div>\n  <div style='text-align: center;'>\n    <div style='font-size: 32px; margin-bottom: 8px;'>[S]</div>\n    <div style='font-size: 14px; font-weight: bold; color: #00d8ff;'>Serial (RFC2217)</div>\n    <div style='font-size: 11px; color: #8892b0; margin-top: 4px;'>Puerto 4000</div>\n  </div>\n  <div style='font-size: 24px; color: #00d8ff;'>-></div>\n  <div style='text-align: center;'>\n    <div style='font-size: 32px; margin-bottom: 8px;'>[R]</div>\n    <div style='font-size: 14px; font-weight: bold; color: #00d8ff;'>Redis 7</div>\n    <div style='font-size: 11px; color: #8892b0; margin-top: 4px;'>Streams + Hashes + Lists</div>\n  </div>\n  <div style='font-size: 24px; color: #00d8ff;'>-></div>\n  <div style='text-align: center;'>\n    <div style='font-size: 32px; margin-bottom: 8px;'>[G]</div>\n    <div style='font-size: 14px; font-weight: bold; color: #00d8ff;'>Grafana 10.4</div>\n    <div style='font-size: 11px; color: #8892b0; margin-top: 4px;'>Dashboards + Alertas</div>\n  </div>\n  <div style='font-size: 24px; color: #00d8ff;'>+</div>\n  <div style='text-align: center;'>\n    <div style='font-size: 32px; margin-bottom: 8px;'>[M]</div>\n    <div style='font-size: 14px; font-weight: bold; color: #00d8ff;'>MQTT Mosquitto</div>\n    <div style='font-size: 11px; color: #8892b0; margin-top: 4px;'>Pub/Sub en tiempo real</div>\n  </div>\n</div>",
        "readOnly": true
      },
      "datasource": null,
      "title": ""
    },
