# SMTP CONFIG PARA GRAFANA (GMAIL)

# Servidor SMTP de Gmail (puerto 587 = STARTTLS)
GRAFANA_SMTP_HOST=smtp.gmail.com:587

# Correo de Gmail que enviará las alertas
GRAFANA_SMTP_USER=tu_correo@gmail.com

# Contraseña de aplicación (16 caracteres, NO tu contraseña normal)
# Ejemplo: abcdefghijklmnop
GRAFANA_SMTP_PASSWORD=tu_contraseña_de_aplicacion

# Dirección desde la que se envían los correos (debe coincidir con el USER)
GRAFANA_SMTP_FROM_ADDRESS=tu_correo@gmail.com

# Nombre que aparecerá como remitente en los correos
GRAFANA_SMTP_FROM_NAME=IoT Alerts System